# Keep large, generated geospatial and raster result artifacts out of normal Git blobs.
results/**/*.tif filter=lfs diff=lfs merge=lfs -text
results/**/*.tiff filter=lfs diff=lfs merge=lfs -text
results/**/*.graphml filter=lfs diff=lfs merge=lfs -text
results/**/*.geojson filter=lfs diff=lfs merge=lfs -text
